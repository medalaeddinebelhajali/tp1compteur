<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <!-- Titre -->
    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon Compteur"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#263238"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp" />

    <!-- Petit texte -->
    <TextView
        android:id="@+id/textViewInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Utilisez les boutons pour modifier le compteur"
        android:textSize="14sp"
        android:textColor="#78909C"
        app:layout_constraintTop_toBottomOf="@id/textViewTitre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Compteur -->
    <TextView
        android:id="@+id/textViewCompteur"
        android:layout_width="200dp"
        android:layout_height="130dp"
        android:gravity="center"
        android:text="0"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:background="#E3F2FD"
        app:layout_constraintTop_toBottomOf="@id/textViewInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp" />

    <!-- Bouton - -->
    <Button
        android:id="@+id/buttonDecrementer"
        android:layout_width="110dp"
        android:layout_height="60dp"
        android:text="-"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#EF5350"
        app:layout_constraintTop_toBottomOf="@id/textViewCompteur"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="35dp" />

    <!-- Bouton + -->
    <Button
        android:id="@+id/buttonIncrementer"
        android:layout_width="110dp"
        android:layout_height="60dp"
        android:text="+"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#43A047"
        app:layout_constraintTop_toBottomOf="@id/textViewCompteur"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp" />

    <!-- Bouton Réinitialiser -->
    <Button
        android:id="@+id/buttonReinitialiser"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Réinitialiser"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#37474F"
        android:backgroundTint="#CFD8DC"
        app:layout_constraintTop_toBottomOf="@id/buttonDecrementer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>